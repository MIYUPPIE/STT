Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /RobotModel1
        - /TF1
      Splitter Ratio: 0.5
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Displays:
    # Fine 10 cm grid so the small (0.2 m) chassis has useful scale cues around
    # it; large 2.5 m grid would make the robot look like a dot.
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Cell Size: 0.1
      Line Style:
        Line Width: 0.005
      Plane Cell Count: 40
      Color: 90; 90; 90
      Enabled: true
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Description Topic:
        Value: /robot_description
      TF Prefix: ""
      Alpha: 1
      Visual Enabled: true
      Collision Enabled: false
      Enabled: true
    - Class: rviz_default_plugins/TF
      Name: TF
      Show Names: false
      Show Axes: true
      Show Arrows: false
      Marker Scale: 0.15
      Enabled: true
    # Real-robot dead reckoning. Thin green arrow trail = where robot_bridge
    # thinks the ESP32 is after integrating commanded wheel speeds.
    - Class: rviz_default_plugins/Odometry
      Name: Odometry (real)
      Topic:
        Value: /odom
      Keep: 200
      Position Tolerance: 0.02
      Angle Tolerance: 0.05
      Shape:
        Value: Arrow
        Color: 25; 200; 25
        Length: 0.12
        Head Length: 0.04
        Shaft Diameter: 0.015
        Head Diameter: 0.03
        Alpha: 0.9
      Enabled: true
    # Gazebo ground-truth pose. Orange arrow trail = where the sim robot is in
    # the physics world. Divergence from the green trail = calibration drift.
    - Class: rviz_default_plugins/Odometry
      Name: Odometry (sim)
      Topic:
        Value: /sim_odom
      Keep: 200
      Position Tolerance: 0.02
      Angle Tolerance: 0.05
      Shape:
        Value: Arrow
        Color: 230; 110; 25
        Length: 0.12
        Head Length: 0.04
        Shaft Diameter: 0.015
        Head Diameter: 0.03
        Alpha: 0.9
      Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: odom
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Measure
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Value: /goal_pose
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      # Close enough for a 0.2 m chassis to fill the viewport; focal point
      # slightly above the ground so the camera orbits the robot's body.
      Distance: 0.8
      Focal Point: {X: 0, Y: 0, Z: 0.05}
      Pitch: 0.55
      Yaw: 0.8
      Target Frame: base_footprint
      Name: Current View
Window Geometry:
  Height: 800
  Width: 1280
  Hide Left Dock: false
  Hide Right Dock: true
