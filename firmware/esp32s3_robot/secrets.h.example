// secrets.h.example — copy to secrets.h (git-ignored) and fill in your WiFi.
// The ESP32-S3 only joins 2.4 GHz networks; the laptop running live_caption.py
// must be on the same network.
#pragma once

#define WIFI_SSID     "your-2.4GHz-ssid"
#define WIFI_PASSWORD "your-password"

// Password for wireless (OTA) uploads from the Arduino IDE. Pick your own.
#define OTA_PASSWORD  "change-me"
