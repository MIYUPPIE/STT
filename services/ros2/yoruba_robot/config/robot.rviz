Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Cell Size: 0.5
      Line Style:
        Line Width: 0.02
      Plane Cell Count: 20
      Enabled: true
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Description Topic:
        Value: /robot_description
      TF Prefix: ""
      Enabled: true
    - Class: rviz_default_plugins/TF
      Name: TF
      Show Names: true
      Show Axes: true
      Enabled: true
    - Class: rviz_default_plugins/Odometry
      Name: Odometry (real)
      Topic:
        Value: /odom
      Keep: 100
      Shape:
        Color: 25; 180; 25
        Length: 0.15
        Head Length: 0.05
      Enabled: true
    - Class: rviz_default_plugins/Odometry
      Name: Odometry (sim)
      Topic:
        Value: /sim_odom
      Keep: 100
      Shape:
        Color: 220; 90; 30
        Length: 0.15
        Head Length: 0.05
      Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: odom
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Measure
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 2.5
      Focal Point: {X: 0, Y: 0, Z: 0}
      Pitch: 0.6
      Yaw: 0.785
      Name: Current View
Window Geometry:
  Height: 800
  Width: 1280
  Hide Left Dock: false
  Hide Right Dock: true
