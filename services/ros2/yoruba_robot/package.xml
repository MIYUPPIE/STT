<?xml version="1.0"?>
<package format="3">
  <name>yoruba_robot</name>
  <version>0.1.0</version>
  <description>
    Digital twin for the Yoruba voice-controlled 2-wheel robot. Bridges ROS2
    /cmd_vel to the real ESP32 (over WiFi) and to a matching Gazebo model, and
    republishes voice-pipeline commands from live_caption.py onto /cmd_vel.
  </description>
  <maintainer email="yemokanlawon@gmail.com">Olayemi</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>teleop_twist_keyboard</exec_depend>

  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
